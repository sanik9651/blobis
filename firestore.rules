rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - allow read/write for all (Telegram Mini App без Firebase Auth)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Leaderboard - read for all, write only through Cloud Functions
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }

    // Global market state (optional)
    match /market/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
