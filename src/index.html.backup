<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Blobis - Рыбалка</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        .app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            max-width: 600px;
            margin: 0 auto;
            background: linear-gradient(180deg, #1a1a1a 0%, #0a0a0a 100%);
        }

        .header {
            padding: 20px 20px 15px;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .user-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .user-name {
            font-size: 1.2em;
            font-weight: 600;
            color: #ffffff;
        }

        .level-badge {
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .balance {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 2em;
            font-weight: 700;
            color: #ffffff;
        }

        .coin-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #ffd700, #ffed4e);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2em;
            box-shadow: 0 4px 12px rgba(255, 215, 0, 0.3);
        }

        .content {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 80px;
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Fishing Tab */
        .fishing-tab {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
        }

        .fish-counter {
            font-size: 1.1em;
            color: #888;
            margin-bottom: 30px;
        }

        .fish-button {
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            border: 3px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 6em;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
        }

        .fish-button::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .fish-button:hover::before {
            opacity: 1;
        }

        .fish-button:active {
            transform: scale(0.95);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
        }

        .fish-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .loading {
            display: none;
            margin-top: 30px;
            text-align: center;
        }

        .loading.show {
            display: block;
        }

        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top: 3px solid #ffffff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .result {
            margin-top: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: none;
            max-width: 320px;
        }

        .result.show {
            display: block;
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fish-name {
            font-size: 1.4em;
            font-weight: 700;
            margin-bottom: 12px;
            text-align: center;
        }

        .fish-rarity {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .fish-stats {
            display: grid;
            gap: 10px;
            margin-top: 15px;
        }

        .fish-stat {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .fish-stat:last-child {
            border-bottom: none;
        }

        .stat-label {
            color: #888;
            font-size: 0.9em;
        }

        .stat-value {
            font-weight: 600;
            color: #ffffff;
        }

        /* Tasks Tab */
        .tasks-tab {
            padding: 20px;
        }

        .task-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .task-info h3 {
            font-size: 1.1em;
            margin-bottom: 6px;
        }

        .task-reward {
            color: #ffd700;
            font-size: 0.9em;
        }

        .task-button {
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .task-button:active {
            transform: scale(0.95);
        }

        /* Inventory Tab */
        .inventory-tab {
            padding: 20px;
        }

        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }

        .inventory-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
        }

        .item-icon {
            font-size: 3em;
            margin-bottom: 8px;
        }

        .item-name {
            font-size: 0.9em;
            margin-bottom: 4px;
        }

        .item-count {
            color: #888;
            font-size: 0.85em;
        }

        /* Market Tab */
        .market-tab {
            padding: 20px;
        }

        .market-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item-details h3 {
            font-size: 1.1em;
            margin-bottom: 6px;
        }

        .item-price {
            color: #ffd700;
            font-size: 0.9em;
        }

        /* Shop Tab */
        .shop-tab {
            padding: 20px;
        }

        .shop-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .shop-item h3 {
            font-size: 1.1em;
            margin-bottom: 8px;
        }

        .shop-item p {
            color: #888;
            font-size: 0.9em;
            margin-bottom: 12px;
        }

        .shop-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .shop-price {
            color: #ffd700;
            font-weight: 600;
            font-size: 1.1em;
        }

        .buy-button {
            background: linear-gradient(135deg, #ffffff, #e0e0e0);
            color: #000000;
            border: none;
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .buy-button:active {
            transform: scale(0.95);
        }

        /* Bottom Navigation */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: space-around;
            padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
            max-width: 600px;
            margin: 0 auto;
        }

        .nav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 8px;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            background: none;
            color: #666;
        }

        .nav-item.active {
            color: #ffffff;
        }

        .nav-icon {
            font-size: 1.5em;
        }

        .nav-label {
            font-size: 0.7em;
            font-weight: 500;
        }

        .error {
            background: rgba(255, 59, 48, 0.15);
            border: 1px solid rgba(255, 59, 48, 0.3);
            padding: 16px;
            border-radius: 12px;
            margin: 20px;
            display: none;
            color: #ff3b30;
        }

        .error.show {
            display: block;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }

        .empty-state-icon {
            font-size: 4em;
            margin-bottom: 16px;
            opacity: 0.5;
        }

        .empty-state-text {
            font-size: 1.1em;
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="header">
            <div class="user-info">
                <div class="user-name" id="userName">Игрок</div>
                <div class="level-badge">⭐ Уровень <span id="level">1</span></div>
            </div>
            <div class="balance">
                <div class="coin-icon">💰</div>
                <span id="coins">0</span>
            </div>
        </div>

        <div class="content">
            <!-- Fishing Tab -->
            <div class="tab-content active" id="fishingTab">
                <div class="fishing-tab">
                    <div class="fish-counter">🐟 Поймано: <span id="totalFish">0</span></div>

                    <button class="fish-button" id="fishButton" onclick="goFishing()">
                        🎣
                    </button>

                    <div class="loading" id="loading">
                        <div class="spinner"></div>
                        <p>Ловим рыбу...</p>
                    </div>

                    <div class="result" id="result">
                        <div style="text-align: center;">
                            <div class="fish-name" id="fishName"></div>
                            <div class="fish-rarity" id="fishRarity"></div>
                        </div>
                        <div class="fish-stats">
                            <div class="fish-stat">
                                <span class="stat-label">💎 Ценность</span>
                                <span class="stat-value"><span id="fishValue"></span> монет</span>
                            </div>
                            <div class="fish-stat">
                                <span class="stat-label">⚖️ Вес</span>
                                <span class="stat-value"><span id="fishWeight"></span> кг</span>
                            </div>
                            <div class="fish-stat">
                                <span class="stat-label">📏 Размер</span>
                                <span class="stat-value"><span id="fishSize"></span> см</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tasks Tab -->
            <div class="tab-content" id="tasksTab">
                <div class="tasks-tab">
                    <div class="task-card">
                        <div class="task-info">
                            <h3>Поймай 10 рыб</h3>
                            <div class="task-reward">+500 💰</div>
                        </div>
                        <button class="task-button">Начать</button>
                    </div>
                    <div class="task-card">
                        <div class="task-info">
                            <h3>Поймай редкую рыбу</h3>
                            <div class="task-reward">+1000 💰</div>
                        </div>
                        <button class="task-button">Начать</button>
                    </div>
                    <div class="task-card">
                        <div class="task-info">
                            <h3>Достигни 5 уровня</h3>
                            <div class="task-reward">+2000 💰</div>
                        </div>
                        <button class="task-button">Начать</button>
                    </div>
                </div>
            </div>

            <!-- Inventory Tab -->
            <div class="tab-content" id="inventoryTab">
                <div class="inventory-tab">
                    <div class="empty-state">
                        <div class="empty-state-icon">📦</div>
                        <div class="empty-state-text">Инвентарь пуст</div>
                    </div>
                </div>
            </div>

            <!-- Market Tab -->
            <div class="tab-content" id="marketTab">
                <div class="market-tab">
                    <div class="empty-state">
                        <div class="empty-state-icon">🏪</div>
                        <div class="empty-state-text">Рынок в разработке</div>
                    </div>
                </div>
            </div>

            <!-- Shop Tab -->
            <div class="tab-content" id="shopTab">
                <div class="shop-tab">
                    <div class="shop-item">
                        <h3>🎣 Улучшенная удочка</h3>
                        <p>Увеличивает шанс поймать редкую рыбу</p>
                        <div class="shop-footer">
                            <div class="shop-price">1000 💰</div>
                            <button class="buy-button">Купить</button>
                        </div>
                    </div>
                    <div class="shop-item">
                        <h3>🪝 Золотой крючок</h3>
                        <p>Удваивает ценность пойманной рыбы</p>
                        <div class="shop-footer">
                            <div class="shop-price">5000 💰</div>
                            <button class="buy-button">Купить</button>
                        </div>
                    </div>
                    <div class="shop-item">
                        <h3>⚡ Энергетический напиток</h3>
                        <p>Убирает задержку между ловлей на 1 час</p>
                        <div class="shop-footer">
                            <div class="shop-price">500 💰</div>
                            <button class="buy-button">Купить</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="error" id="error"></div>
        </div>

        <nav class="bottom-nav">
            <button class="nav-item active" onclick="switchTab('fishing')">
                <div class="nav-icon">🎣</div>
                <div class="nav-label">Рыбалка</div>
            </button>
            <button class="nav-item" onclick="switchTab('tasks')">
                <div class="nav-icon">📋</div>
                <div class="nav-label">Задания</div>
            </button>
            <button class="nav-item" onclick="switchTab('inventory')">
                <div class="nav-icon">📦</div>
                <div class="nav-label">Инвентарь</div>
            </button>
            <button class="nav-item" onclick="switchTab('market')">
                <div class="nav-icon">🏪</div>
                <div class="nav-label">Рынок</div>
            </button>
            <button class="nav-item" onclick="switchTab('shop')">
                <div class="nav-icon">🛒</div>
                <div class="nav-label">Магазин</div>
            </button>
        </nav>
    </div>

    <script>
        let tg = window.Telegram.WebApp;
        tg.expand();
        tg.setHeaderColor('#0a0a0a');
        tg.setBackgroundColor('#0a0a0a');

        const API_URL = window.location.origin;
        let userId = null;
        let userData = null;
        let currentTab = 'fishing';

        // Получаем ID пользователя из Telegram
        if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
            userId = tg.initDataUnsafe.user.id;
            const username = tg.initDataUnsafe.user.username || tg.initDataUnsafe.user.first_name || 'Игрок';
            document.getElementById('userName').textContent = username;
            loadUserData();
        } else {
            // Для тестирования без Telegram
            userId = 123456789;
            document.getElementById('userName').textContent = 'Тестовый игрок';
            loadUserData();
        }

        async function loadUserData() {
            try {
                // Регистрируем или обновляем пользователя
                const username = tg.initDataUnsafe?.user?.username || `user_${userId}`;
                const registerResponse = await fetch(`${API_URL}/api/user/${userId}/update`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ username: username })
                });

                if (!registerResponse.ok) {
                    throw new Error('Failed to register user');
                }

                // Загружаем данные пользователя
                const response = await fetch(`${API_URL}/api/user/${userId}`);
                if (!response.ok) {
                    throw new Error('Failed to load user data');
                }

                userData = await response.json();
                updateStats();
            } catch (error) {
                console.error('Error loading user data:', error);
                showError('Ошибка загрузки данных пользователя');
            }
        }

        function updateStats() {
            if (!userData) return;

            document.getElementById('coins').textContent = Math.floor(userData.coins).toLocaleString();
            document.getElementById('level').textContent = userData.level;
            document.getElementById('totalFish').textContent = userData.total_fish_caught;
        }

        function switchTab(tabName) {
            // Скрываем все вкладки
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });

            // Убираем активный класс со всех кнопок навигации
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });

            // Показываем выбранную вкладку
            const tabMap = {
                'fishing': 'fishingTab',
                'tasks': 'tasksTab',
                'inventory': 'inventoryTab',
                'market': 'marketTab',
                'shop': 'shopTab'
            };

            document.getElementById(tabMap[tabName]).classList.add('active');

            // Активируем соответствующую кнопку навигации
            event.currentTarget.classList.add('active');

            currentTab = tabName;

            // Вибрация при переключении
            if (tg.HapticFeedback) {
                tg.HapticFeedback.impactOccurred('light');
            }
        }

        async function goFishing() {
            const button = document.getElementById('fishButton');
            const loading = document.getElementById('loading');
            const result = document.getElementById('result');
            const error = document.getElementById('error');

            button.disabled = true;
            loading.classList.add('show');
            result.classList.remove('show');
            error.classList.remove('show');

            // Вибрация при нажатии
            if (tg.HapticFeedback) {
                tg.HapticFeedback.impactOccurred('medium');
            }

            try {
                const response = await fetch(`${API_URL}/api/user/${userId}/fish`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fish');
                }

                const fish = await response.json();
                displayFish(fish);

                // Вибрация при успешной ловле
                if (tg.HapticFeedback) {
                    tg.HapticFeedback.notificationOccurred('success');
                }

                // Обновляем данные пользователя
                await loadUserData();
            } catch (error) {
                console.error('Error fishing:', error);
                showError('Ошибка при ловле рыбы. Попробуйте снова.');

                if (tg.HapticFeedback) {
                    tg.HapticFeedback.notificationOccurred('error');
                }
            } finally {
                loading.classList.remove('show');
                button.disabled = false;
            }
        }

        function displayFish(fish) {
            const result = document.getElementById('result');
            const rarityColors = {
                'common': '#4a4a4a',
                'rare': '#3b82f6',
                'epic': '#a855f7',
                'legendary': '#f59e0b',
                'mythical': '#ec4899'
            };

            const rarityNames = {
                'common': 'Обычная',
                'rare': 'Редкая',
                'epic': 'Эпическая',
                'legendary': 'Легендарная',
                'mythical': 'Мифическая'
            };

            document.getElementById('fishName').textContent = fish.name;
            document.getElementById('fishValue').textContent = fish.coin_value.toLocaleString();
            document.getElementById('fishWeight').textContent = fish.weight?.toFixed(2) || '?';
            document.getElementById('fishSize').textContent = fish.size?.toFixed(2) || '?';

            const rarityElement = document.getElementById('fishRarity');
            rarityElement.textContent = rarityNames[fish.rarity] || fish.rarity;
            rarityElement.style.backgroundColor = rarityColors[fish.rarity] || '#4a4a4a';

            result.classList.add('show');
        }

        function showError(message) {
            const error = document.getElementById('error');
            error.textContent = message;
            error.classList.add('show');

            setTimeout(() => {
                error.classList.remove('show');
            }, 5000);
        }

        // Обработчики для кнопок магазина
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.buy-button').forEach(button => {
                button.addEventListener('click', () => {
                    if (tg.HapticFeedback) {
                        tg.HapticFeedback.impactOccurred('light');
                    }
                    tg.showAlert('Покупки будут доступны в следующем обновлении!');
                });
            });

            document.querySelectorAll('.task-button').forEach(button => {
                button.addEventListener('click', () => {
                    if (tg.HapticFeedback) {
                        tg.HapticFeedback.impactOccurred('light');
                    }
                    tg.showAlert('Система заданий в разработке!');
                });
            });
        });
    </script>
</body>
</html>
