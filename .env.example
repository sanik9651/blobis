# Telegram Bot Token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blobis_db

# Hugging Face API Token (optional)
HF_API_TOKEN=

# Server settings
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development

# Web App URL (опционально, для Mini App в Telegram)
# Должен быть HTTPS URL (например, через ngrok)
# Пример: WEBAPP_URL=https://abc123.ngrok-free.app
# Если не указан, Web App кнопка не будет отображаться
WEBAPP_URL=
